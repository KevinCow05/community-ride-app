# Community Ride — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to GitHub

# ─── Firebase ────────────────────────────────────────────────────────────────
# Get these from Firebase Console → Project Settings → Your apps → Web app

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=kevincow-carpool-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kevincow-carpool-app
VITE_FIREBASE_STORAGE_BUCKET=kevincow-carpool-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=601810890900
VITE_FIREBASE_APP_ID=1:601810890900:web:106f486ae707285d52c481

# Firebase Cloud Messaging — Web Push VAPID key
# Firebase Console → Project Settings → Cloud Messaging → Web configuration → Web Push certificates
VITE_FIREBASE_VAPID_KEY=

# ─── Cloudinary ──────────────────────────────────────────────────────────────
# Get your cloud name from cloudinary.com → Dashboard
# Upload preset must be named "community-ride" and set to UNSIGNED

VITE_CLOUDINARY_CLOUD_NAME=dus3iswfc
VITE_CLOUDINARY_UPLOAD_PRESET=community-ride

# ─── Community Config ─────────────────────────────────────────────────────────
# Your community's display name — shown in the app header and on safety cards

VITE_COMMUNITY_NAME=KevinCow Carpool App

# ─── Sentry (error monitoring) ───────────────────────────────────────────────
# Get this from sentry.io → Project Settings → Client Keys (DSN)

VITE_SENTRY_DSN=
